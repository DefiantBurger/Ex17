read_file -format sverilog {saturate.sv}
read_file -format sverilog {PID.sv}
read_file -format sverilog {SegwayMath.sv}
read_file -format sverilog {balance_cntrl.sv}

current_design balance_cntrl
link

create_clock -name "clk" -period 8 -waveform {0 4} clk

set_dont_touch_network [find port clk]

set prim_inputs [remove_from_collection [all_inputs] [find port clk]]
set scnd_inputs [remove_from_collection $prim_inputs [find port rst_n]]

set_input_delay -clock clk 0.3 [copy_collection $prim_inputs]

# set_driving_cell -lib_cell NAND2X2_RVT -pin Z -from_pin A1 -library saed32_edk [copy_collection $prim_inputs]
set_driving_cell -lib_cell NAND2X2_RVT -library saed32rvt_tt0p85v25c $scnd_inputs

set_output_delay -clock clk 0.75 [all_outputs]

set_load 0.05 [all_outputs]

set_max_transition 0.15 [current_design]

set_wire_load_model -name 16000 -library saed32rvt_tt0p85v25c

compile
ungroup -all -flatten
compile

report_timing -delay_type min > timing_min.rpt
report_timing -delay_type max > timing_max.rpt

report_area > area.rpt

write -format verilog balance_cntrl -output balance_cntrl.vg
